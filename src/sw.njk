/* Service worker do {{ site.nome }} — gerado automaticamente a cada publicação. */
const VERSAO = "{{ buildId }}";
const BASE = {{ "/" | comBase | json | safe }};
const CACHE_PAGINAS = "paginas-" + VERSAO;
const CACHE_ESTATICO = "estatico-" + VERSAO;
const CACHE_PDFS = "pdfs-v1"; // mantido entre versões (PDFs salvos pelo usuário)
const CACHE_SALVOS = "salvos-paginas"; // páginas marcadas como "Salvar"
const OFFLINE = BASE + "offline/";

const PRECACHE = [
  BASE,
  OFFLINE,
  BASE + "buscar/",
  BASE + "salvos/",
  BASE + "categorias/",
  BASE + "search-index.json",
  BASE + "manifest.webmanifest",
  BASE + "assets/css/style.css?v=" + VERSAO,
  BASE + "assets/js/app.js?v=" + VERSAO,
  BASE + "assets/icons/favicon.svg",
  BASE + "assets/icons/icon-192.png",
];

self.addEventListener("install", (event) => {
  event.waitUntil(
    caches.open(CACHE_ESTATICO)
      .then((cache) => Promise.all(PRECACHE.map((url) =>
        cache.add(new Request(url, { cache: "reload" })).catch(() => null))))
      .then(() => self.skipWaiting())
  );
});

self.addEventListener("activate", (event) => {
  event.waitUntil(
    caches.keys().then((keys) => Promise.all(
      keys.filter((k) => k !== CACHE_PAGINAS && k !== CACHE_ESTATICO && k !== CACHE_PDFS && k !== CACHE_SALVOS)
          .map((k) => caches.delete(k))
    )).then(() => self.clients.claim())
  );
});

function mesmaOrigem(url) { return url.origin === self.location.origin; }

async function redePrimeiro(request) {
  const cache = await caches.open(CACHE_PAGINAS);
  try {
    const resp = await fetch(request);
    if (resp && resp.ok) cache.put(request, resp.clone());
    return resp;
  } catch (e) {
    const salvo = (await cache.match(request, { ignoreSearch: true })) ||
                  (await caches.match(request, { ignoreSearch: true }));
    return salvo || (await caches.match(OFFLINE)) || new Response("Offline", { status: 503 });
  }
}

async function cacheAtualizando(request) {
  const cache = await caches.open(CACHE_ESTATICO);
  const salvo = await cache.match(request);
  const rede = fetch(request).then((resp) => {
    if (resp && resp.ok) cache.put(request, resp.clone());
    return resp;
  }).catch(() => null);
  return salvo || (await rede) || new Response("", { status: 504 });
}

async function pdf(request) {
  const salvo = await caches.match(request, { ignoreSearch: true });
  if (salvo) return salvo;
  return fetch(request);
}

self.addEventListener("fetch", (event) => {
  const req = event.request;
  if (req.method !== "GET") return;
  const url = new URL(req.url);
  if (!mesmaOrigem(url)) return;                 // anúncios e serviços externos: direto da rede
  if (url.pathname.startsWith(BASE + "admin")) return; // painel sempre online
  if (req.headers.has("range")) return;          // leitura parcial de PDF: deixa o navegador cuidar

  if (req.mode === "navigate") { event.respondWith(redePrimeiro(req)); return; }
  if (url.pathname.endsWith(".pdf")) { event.respondWith(pdf(req)); return; }
  if (url.pathname.endsWith("search-index.json")) { event.respondWith(redePrimeiro(req)); return; }
  event.respondWith(cacheAtualizando(req));
});

self.addEventListener("message", (event) => {
  const msg = event.data || {};
  if (msg.tipo === "salvar-pdf" && msg.url) {
    event.waitUntil(
      caches.open(CACHE_PDFS).then((c) => c.add(msg.url))
        .then(() => event.source && event.source.postMessage({ tipo: "pdf-salvo", url: msg.url }))
        .catch(() => event.source && event.source.postMessage({ tipo: "pdf-erro", url: msg.url }))
    );
  }
  if (msg.tipo === "salvar-pagina" && msg.url) {
    event.waitUntil(caches.open(CACHE_PAGINAS).then((c) => c.add(msg.url)).catch(() => null));
  }
});
